NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGIN=*

# Midtrans credentials: keep secrets only on the backend.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_ENVIRONMENT=sandbox

# MikroTik credentials: keep secrets only on the backend.
MIKROTIK_BASE_URL=https://192.0.2.1
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_VERIFY_TLS=true

# Database: required for production persistence.
DATABASE_URL=
